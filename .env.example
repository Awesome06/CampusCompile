# ==========================================
# CAMPUSCOMPILE ENVIRONMENT BLUEPRINT
# Copy this file to '.env' and fill in your secrets.
# ==========================================

# --- 1. PostgreSQL Database ---
POSTGRES_USER=campus_admin
POSTGRES_PASSWORD=your_secure_db_password

# --- 2. S3 / MinIO Storage ---
# These act as both the MinIO login credentials and the S3 access keys
S3_ACCESS_KEY=campus_storage_admin
S3_SECRET_KEY=your_secure_storage_password

# --- 3. Azure Active Directory (SSO) ---
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# --- 4. Stanford MOSS (Anti-Cheat) ---
# Register by emailing moss@moss.stanford.edu
MOSS_USER_ID=your_moss_id