# ==========================================
# CAMPUSCOMPILE ENVIRONMENT BLUEPRINT
# Copy this file to '.env' and fill in your secrets.
# ==========================================

# --- 1. Application & Server Configuration ---
# BASE_URL: Expects a valid HTTP/HTTPS URL string pointing to your frontend (e.g., http://localhost:5173 or https://campuscompile.com).
BASE_URL=http://localhost:5173
# GIN_MODE: Expects a specific string. Use 'debug' for local development and 'release' for production.
GIN_MODE=

# --- 2. PostgreSQL Database ---
# POSTGRES_USER: Expects a standard string representing the database role/username.
POSTGRES_USER=postgres_user
# POSTGRES_PASSWORD: Expects a strong, alphanumeric string.
POSTGRES_PASSWORD=postgres_password
# POSTGRES_DB: Expects a string representing the target database name.
POSTGRES_DB=CampusCompile_db

# --- 3. Redis Configuration ---
# REDIS_AUTH_TIMEOUT: Expects a time duration string parsed by Go (e.g., '1s', '500ms', '2m').
REDIS_AUTH_TIMEOUT=1s

# --- 4. S3 / MinIO Object Storage ---
# S3_ACCESS_KEY: Expects an alphanumeric string acting as the identifier/username.
S3_ACCESS_KEY=access_key
# S3_SECRET_KEY: Expects a long, complex cryptographic string.
S3_SECRET_KEY=secret_key

# --- 5. Azure Active Directory (SSO) & OAuth ---
# AZURE_TENANT_ID: Expects a standard UUID format (e.g., 12345678-1234-1234-1234-1234567890ab).
AZURE_TENANT_ID=tenant_id
# AZURE_CLIENT_ID: Expects a standard UUID format representing the registered app.
AZURE_CLIENT_ID=client_id
# AZURE_CLIENT_SECRET: Expects a generated, high-entropy secret string from the Azure portal.
AZURE_CLIENT_SECRET=secret_client_id
# REDIRECT_URL: Expects an absolute URL where the OAuth provider will send the callback payload.
REDIRECT_URL=http://localhost:8080/api/auth/callback
# OAUTH_INSECURE_LOCAL_DEV: Expects an integer flag ('1' for local dev, leave completely blank for production to enforce HTTPS).
OAUTH_INSECURE_LOCAL_DEV=

# --- 6. Security & Session Management ---
# IP_HASH_SALT: Expects a long, random cryptographic string (e.g., a 32-character hex string) to securely hash user IPs.
IP_HASH_SALT=changeme_ip_hash_salt
# COOKIE_DOMAIN: Expects a string representing the top-level domain. Leave completely empty for localhost, or use '.campuscompile.com' to share cookies across subdomains in production.
COOKIE_DOMAIN=

# --- 7. External Services (Stanford MOSS) ---
# MOSS_USER_ID: Expects a purely numeric integer ID assigned to you via email by the Stanford MOSS system.
MOSS_USER_ID=moss_id